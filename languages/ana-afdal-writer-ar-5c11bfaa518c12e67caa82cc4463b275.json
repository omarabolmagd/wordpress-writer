\u0648\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0648\u0627\u0644\u062e\u0644\u0627\u0635\u0629 \u0648\u062f\u0639\u0648\u0629 \u062a\u064a\u0644\u064a\u062c\u0631\u0627\u0645 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."],"Add section":["\u0625\u0636\u0627\u0641\u0629 \u0642\u0633\u0645"],"FAQ questions":["\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629"],"None suggested.":["\u0644\u0627 \u062a\u0648\u062c\u062f \u0627\u0642\u062a\u0631\u0627\u062d\u0627\u062a."],"Sources to cite":["\u0645\u0635\u0627\u062f\u0631 \u0644\u0644\u0627\u0633\u062a\u0634\u0647\u0627\u062f"],"Ticked sources are offered to the writer; each link is checked live before the draft is saved.":["\u062a\u064f\u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0643\u0627\u062a\u0628\u060c \u0648\u064a\u064f\u0641\u062d\u0635 \u0643\u0644 \u0631\u0627\u0628\u0637 \u0645\u0628\u0627\u0634\u0631\u0629 \u0642\u0628\u0644 \u062d\u0641\u0638 \u0627\u0644\u0645\u0633\u0648\u062f\u0629."],"No sources found.":["\u0644\u0645 \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u0649 \u0645\u0635\u0627\u062f\u0631."],"Approve and write":["\u0648\u0627\u0641\u0642 \u0648\u0627\u0628\u062f\u0623 \u0627\u0644\u0643\u062a\u0627\u0628\u0629"],"Writing, images and checks usually take 2\u20134 minutes. Keep this page open for the fastest result.":["\u062a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0641\u062d\u0648\u0635 \u0639\u0627\u062f\u0629\u064b \u0645\u0646 2 \u0625\u0644\u0649 4 \u062f\u0642\u0627\u0626\u0642. \u0623\u0628\u0642\u0650 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0641\u062a\u0648\u062d\u0629 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0623\u0633\u0631\u0639 \u0646\u062a\u064a\u062c\u0629."],"Add at least one section.":["\u0623\u0636\u0641 \u0642\u0633\u0645\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644."],"Name the new category, or pick an existing one.":["\u0627\u0643\u062a\u0628 \u0627\u0633\u0645 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u062c\u062f\u064a\u062f \u0623\u0648 \u0627\u062e\u062a\u0631 \u062a\u0635\u0646\u064a\u0641\u064b\u0627 \u0645\u0648\u062c\u0648\u062f\u064b\u0627."],"Review checklist":["\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629"],"%d item(s) need a look before you publish.":["%d \u0628\u0646\u062f \u064a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0645\u0631\u0627\u062c\u0639\u0629 \u0642\u0628\u0644 \u0627\u0644\u0646\u0634\u0631."],"Everything passed. Give it a final read and publish.":["\u0627\u062c\u062a\u0627\u0632 \u0643\u0644 \u0634\u064a\u0621 \u0627\u0644\u0641\u062d\u0635. \u0627\u0642\u0631\u0623\u0647 \u0642\u0631\u0627\u0621\u0629 \u0623\u062e\u064a\u0631\u0629 \u062b\u0645 \u0627\u0646\u0634\u0631\u0647."],"Approve":["\u0645\u0648\u0627\u0641\u0642\u0629"],"Dismiss":["\u062a\u062c\u0627\u0647\u0644"],"Approved":["\u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629"],"Approved \u2014 added when you publish":["\u062a\u0645\u062a \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u2014 \u064a\u064f\u0636\u0627\u0641 \u0639\u0646\u062f \u0627\u0644\u0646\u0634\u0631"],"Link added":["\u0623\u064f\u0636\u064a\u0641 \u0627\u0644\u0631\u0627\u0628\u0637"],"Dismissed":["\u062a\u0645 \u0627\u0644\u062a\u062c\u0627\u0647\u0644"],"Could not add":["\u062a\u0639\u0630\u0651\u0631\u062a \u0627\u0644\u0625\u0636\u0627\u0641\u0629"],"Links from older posts":["\u0631\u0648\u0627\u0628\u0637 \u0645\u0646 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629"],"Approved links are added to the older posts once this post is published, so no reader lands on a draft.":["\u062a\u064f\u0636\u0627\u0641 \u0