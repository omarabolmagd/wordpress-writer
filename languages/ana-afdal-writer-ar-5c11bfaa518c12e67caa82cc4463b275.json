 \u0630\u0643\u0627\u0621 \u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0644\u0644\u0637\u0644\u0627\u0628"],"Suggest topics":["\u0627\u0642\u062a\u0631\u062d \u0645\u0648\u0627\u0636\u064a\u0639"],"Let the writer choose":["\u062f\u0639 \u0627\u0644\u0643\u0627\u062a\u0628 \u064a\u062e\u062a\u0627\u0631"],"New category\u2026":["\u062a\u0635\u0646\u064a\u0641 \u062c\u062f\u064a\u062f\u2026"],"New category name":["\u0627\u0633\u0645 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u062c\u062f\u064a\u062f"],"2. Or write about your own topic":["2. \u0623\u0648 \u0627\u0643\u062a\u0628 \u0639\u0646 \u0645\u0648\u0636\u0648\u0639 \u062a\u062e\u062a\u0627\u0631\u0647"],"Working title":["\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0628\u062f\u0626\u064a"],"Focus keyphrase (what readers search)":["\u0627\u0644\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0641\u062a\u0627\u062d\u064a\u0629 (\u0645\u0627 \u064a\u0628\u062d\u062b \u0639\u0646\u0647 \u0627\u0644\u0642\u0631\u0627\u0621)"],"Post type":["\u0646\u0648\u0639 \u0627\u0644\u0645\u0642\u0627\u0644"],"Category":["\u0627\u0644\u062a\u0635\u0646\u064a\u0641"],"Notes for the writer (optional)":["\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0644\u0644\u0643\u0627\u062a\u0628 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"],"Start research":["\u0627\u0628\u062f\u0623 \u0627\u0644\u0628\u062d\u062b"],"(untitled)":["(\u0628\u062f\u0648\u0646 \u0639\u0646\u0648\u0627\u0646)"],"Articles":["\u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a"],"Title":["\u0627\u0644\u0639\u0646\u0648\u0627\u0646"],"Status":["\u0627\u0644\u062d\u0627\u0644\u0629"],"Updated":["\u0622\u062e\u0631 \u062a\u062d\u062f\u064a\u062b"],"No articles yet. Pick a topic above to start.":["\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0642\u0627\u0644\u0627\u062a \u0628\u0639\u062f. \u0627\u062e\u062a\u0631 \u0645\u0648\u0636\u0648\u0639\u064b\u0627 \u0628\u0627\u0644\u0623\u0639\u0644\u0649 \u0644\u062a\u0628\u062f\u0623."],"Image":["\u0627\