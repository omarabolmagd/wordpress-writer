#: src/Settings.php:175
msgid "API keys"
msgstr "مفاتيح API"

#: src/Settings.php:176
msgid "Keys are stored in the database and never sent to the browser. To keep them out of the database entirely, define them in wp-config.php instead (AAW_ANTHROPIC_API_KEY, AAW_GEMINI_API_KEY, AAW_PEXELS_API_KEY, AAW_SCREENSHOT_API_KEY)."
msgstr "تُحفظ المفاتيح في قاعدة البيانات ولا تُرسل إلى المتصفح أبدًا. لإبقائها خارج قاعدة البيانات تمامًا، عرّفها في wp-config.php بدلًا من ذلك (AAW_ANTHROPIC_API_KEY وAAW_GEMINI_API_KEY وAAW_PEXELS_API_KEY وAAW_SCREENSHOT_API_KEY)."

#: src/Settings.php:179
msgid "Claude (Anthropic) API key"
msgstr "مفتاح Claude API (Anthropic)"

#: src/Settings.php:179
msgid "Required. Writes the posts and searches the web. Create one at platform.claude.com."
msgstr "مطلوب. يكتب المقالات ويبحث في الويب. أنشئه من platform.claude.com."

#: src/Settings.php:180
msgid "Google Gemini API key"
msgstr "مفتاح Google Gemini API"

#: src/Settings.php:180
msgid "Optional. Needed for AI images. Create one at aistudio.google.com."
msgstr "اختياري. مطلوب لصور الذكاء الاصطناعي. أنشئه من aistudio.google.com."

#: src/Settings.php:181
msgid "Pexels API key"
msgstr "مفتاح Pexels API"

#: src/Settings.php:181
msgid "Optional. Needed for stock photos. Free at pexels.com/api."
